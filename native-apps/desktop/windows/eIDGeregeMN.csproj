<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Хүн юу уншихыг брэнд шийднэ, build нэрээ биш. Product ба
         AssemblyTitle нь exe-ийн шинж чанарын хуудас, Task Manager, Start
         цэс гурав дээр гардаг нэр. -->
    <Product>eID Gerege</Product>
    <AssemblyTitle>eID Gerege</AssemblyTitle>
    <!-- Footer-т "v1.0.9 (10)" гэж харагдана: Version нь маркетингийн
         хувилбар, AssemblyVersion-ий 4 дэх орон нь build дугаар. macOS
         клиентийн хувилбартай нэг мөрөөр явна. -->
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.10</AssemblyVersion>
    <FileVersion>1.0.9.10</FileVersion>
    <RootNamespace>GeregeNexusNativeWin</RootNamespace>
    <FormFactor Condition="'$(FormFactor)' == ''">Desktop</FormFactor>
    <OutputPath>bin\$(Configuration)\$(FormFactor)\</OutputPath>
    <!-- Файлын нэр нь build-ийн таних тэмдэг: form factor бүр өөрийн exe.
         `Native` дэд үг нь юуг ч ялгадаггүй байсан тул хасав. -->
    <AssemblyName>eIDGeregeMN.$(FormFactor)</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FormFactor)' == 'Kiosk'"><DefineConstants>$(DefineConstants);KIOSK</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(FormFactor)' == 'POS'"><DefineConstants>$(DefineConstants);POS</DefineConstants></PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\brand.png" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="GeregeShell.Core\GeregeShell.Core.csproj" />
    <Compile Remove="NativeAuth.cs" />
    <!-- ShellLog нь NativeAuth-тай хамт Core-д компайл хийгддэг (тэр логждог)
         тул энд давхар орвол хоёр assembly-д ижил төрөл үүсч, дуудлага нь
         тодорхойгүй болно. -->
    <Compile Remove="ShellLog.cs" />
    <Compile Remove="GeregeShell.Core\**\*.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
