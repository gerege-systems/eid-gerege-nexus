<Application x:Class="GeregeNexusNativeWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                The eID platform's design system, ported from
                gerege-line/eid/eid-platform-mn. Merged in order: colours first,
                because the type styles reference the brushes by key and a
                StaticResource has to have been seen already.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Spacing.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The shell's own chrome, which is dark whatever the sign-in
                screen is doing: the menu bar, the rail and the footer frame a
                web view rather than sitting on the card surface.
            -->
            <SolidColorBrush x:Key="WindowBackground" Color="#0B0F17" />
            <SolidColorBrush x:Key="MenuBackground" Color="#111827" />
            <SolidColorBrush x:Key="MenuForeground" Color="#F3F4F6" />

            <!--
                Цэсний бичвэрийн өнгө нь хаана байгаагаас хамаарна.

                Дээд мөр нь ХАРАНХУЙ туузан дээр суудаг тул цайвар бичигтэй;
                харин задарч гарах цонх нь системийн ЦАЙВАР popup тул тэнд
                ижил цайвар өнгө үлдвэл цагаан дээр цагаан болж уншигдахаа
                больдог. Foreground нь удамшдаг учир дээд мөрөнд өгсөн өнгө
                доошоо дамжиж, яг тэр алдаа гарч байв. Role-оор нь салгаж
                өгснөөр хоёулаа зөв болно.
            -->
            <Style TargetType="MenuItem">
                <Style.Triggers>
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Foreground" Value="{StaticResource MenuForeground}" />
                        <Setter Property="Padding" Value="10,4" />
                    </Trigger>
                    <Trigger Property="Role" Value="TopLevelItem">
                        <Setter Property="Foreground" Value="{StaticResource MenuForeground}" />
                        <Setter Property="Padding" Value="10,4" />
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter Property="Foreground" Value="{StaticResource EidTextPrimary}" />
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuItem">
                        <Setter Property="Foreground" Value="{StaticResource EidTextPrimary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Their PrimaryButtonStyle: solid accent, white label, Radius.md,
                 and the strong accent while pressed. -->
            <Style x:Key="EidPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource EidAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="shell"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="shell" Property="Background"
                                            Value="{StaticResource EidAccentStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="shell" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Ribbon-ы товч: chrome дээр суудаг тул хүрээгүй, цайвар бичигтэй.
                macOS-ийн ribbonButton — 12pt medium, цагаан 82%, hover дээр
                бүрэн цагаан.
            -->
            <Style x:Key="EidChromeButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#D1FFFFFF" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="shell" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="shell" Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The tab pill. Active is a raised card; inactive is the track. -->
            <Style x:Key="EidTabButton" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource EidMutedForeground}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="pill" Background="Transparent"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pill" Property="Background"
                                            Value="{StaticResource EidCardBackground}" />
                                    <Setter Property="Foreground"
                                            Value="{StaticResource EidTextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Field chrome: 1px stroke, Radius.md, 46 high, like the card's. -->
            <Style x:Key="EidField" TargetType="Control">
                <Setter Property="Height" Value="46" />
                <Setter Property="BorderBrush" Value="{StaticResource EidCardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource EidCardBackground}" />
                <Setter Property="Foreground" Value="{StaticResource EidTextPrimary}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
