    "profile.link_eid_note": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "eID холбосноор Гэрэгэ дугаар тань энэ дансанд бүртгэгдэнэ. Байгууллагууд таны хүсэлтийн хариуг тэр дугаараар тань олж мэдэгддэг тул үүнгүйгээр хариу ирэхгүй."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking your eID records your Gerege number on this account. Organisations answer a request by that number, so without it their answer has nowhere to arrive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking your eID records your Gerege number on this account. Organisations answer a request by that number, so without it their answer has nowhere to arrive."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking your eID records your Gerege number on this account. Organisations answer a request by that number, so without it their answer has nowhere to arrive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking your eID records your Gerege number on this account. Organisations answer a request by that number, so without it their answer has nowhere to arrive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking your eID records your Gerege number on this account. Organisations answer a request by that number, so without it their answer has nowhere to arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking your eID records your Gerege number on this account. Organisations answer a request by that number, so without it their answer has nowhere to arrive."
          }
        }
      }
    },
