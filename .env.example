# eid.gerege.mn — eID Gerege.
#
# Жинхэнэ файл нь серверийн /opt/eid-nexus/.env бөгөөд нууц утгуудтай тул энд
# хэзээ ч commit хийгдэхгүй (.gitignore). Энэ нь тэр файлын хэлбэр.
# deploy.sh нь үүнийг deploy/.env рүү хуулж, compose тэндээс уншина.

# --------------------------------------------------------------- энэ стек
# Портууд нь цөмийн анхдагч (5434 / 8082 / 3008, бүгд зөвхөн loopback) — энэ
# машин дээр өөр стек байхгүй. deploy/docker-compose.yml дотор бичээстэй.
EID_NEXUS_POSTGRES_PASSWORD=

# Production дээр үүнгүйгээр сервер асахаас татгалзана (ValidateProduction).
# Энэ бол энэ суулгацын өөрийн built-in клиентийн нууц.
SSO_DEFAULT_CLIENT_SECRET=

# --------------------------------------------------------------------- образ
# Бүрхүүлийн образ.
#
# Энэ бүтээгдэхүүн frontend-ээ ӨӨРӨӨ зөөхгүй — модульгүй тул цөмийн нийтэлсэн
# бүрхүүл яг таарна.
#
# ТЭМДЭГ нь go.mod-ийн цөмийн ХУВИЛБАРЫН commit: доорх нь backend/v1.17.0-ийн
# өөрийнх нь commit (5767cc3). go.mod-ийн pin хөдлөх бүрд энэ мөр хамт хөдөлнө
# — тэгэхгүй бол бүрхүүл өөр платформын дэлгэцүүдийг үзүүлнэ.
WEB_IMAGE=ghcr.io/gerege-systems/open-gerege-nexus/frontend:5767cc35ef0997caf8ce2695869b280f21364b79

# ------------------------------------------------------------------ цагийн бүс
# Postgres ба Go процесс хоёулаа үүнийг барина — хоёр нь өөр цагтай байвал
# `CURRENT_DATE` болон `nexus.Today()` өөр өдөр дээр ажиллана.
TZ=Asia/Ulaanbaatar

# --------------------------------------------------------------------- домэйн
PUBLIC_ORIGIN=https://eid.gerege.mn

# OIDC-ээр нэвтэрсэн хүнийг эргүүлж явуулж болох хостууд, таслалаар. Яг таарах
# нэрс: дэд домэйн өвлөгдөхгүй. Хоосон орхивол цөмийн анхдагч (nexus.gerege.mn)
# хүчинтэй болж, энэ суулгацын redirect бүр татгалзагдана.
OAUTH_REDIRECT_HOSTS=eid.gerege.mn,admin.eid.gerege.mn,desktop.eid.gerege.mn,mobile.eid.gerege.mn

# ---------------------------------------------------------------------- брэнд
# Хүсэлт бүр дээр уншигдана — образ биш, тохиргоо.
BRAND_NAME=eID Gerege
BRAND_SHORT_NAME=eID Gerege
BRAND_DESCRIPTION=Цахим үнэмлэхээр нэвтрэх нэгдсэн платформ
# eID платформын Brand500. Ширээний клиентүүдийн дизайн систем
# (native-apps/desktop/*/Design) энэ утгыг үндэс болгодог — хоёр нь
# зөрвөл нэг хүн вэб дээр нэг өнгө, аппдаа өөр өнгө харна.
BRAND_THEME_COLOR=#3A6DFF
# Тэмдэг. Замууд нь ЭНЭ хостынх: агуулга нь deploy/brand-assets/, үйлчилгээ
# нь docker-compose.sites.yml-ийн `brand` контейнер, чиглүүлэлт нь nginx-ийн
# `/brand/` (eid.gerege.mn ба admin.eid.gerege.mn хоёулан дээр).
#
# logo нь ил тод — толгой дээр нэрийн хажууд 36px-д сууна.
# icon нь өөрийн хөх дэвсгэртэй — tab, home screen дээр ганцаараа зогсоно.
# maskable нь тасалдаг launcher-т (Android): тэмдэг 62%, дэвсгэр ирмэг хүртэл.
BRAND_LOGO_URL=/brand/logo.png
BRAND_ICON_URL=/brand/icon.png
BRAND_MASKABLE_ICON_URL=/brand/maskable.png

# ---------------------------------------------------------------- eID Mongolia
# Энэ суулгацын relying-party итгэмжлэл. Хоосон бол нэвтрэх дэлгэцийн eID карт
# «session could not be started» гэж хариулна — энэ байрлуулалт дээр тэр нь
# «хэн ч нэвтэрч чадахгүй» гэсэн үг.
#
# Нэр ба бичвэр нь чимэглэл биш: иргэн апп дотроо яг тэдгээрийг уншаад
# зөвшөөрдөг.
#
# Browser callback нь ${PUBLIC_ORIGIN}/auth/eid/callback. Native аппын callback
# платформын backend дээр бүтэн URI-гаар, eID Mongolia RP-ийн callback_hosts-д
# зөвхөн `gerege-eid://` scheme-ээр бүртгэгдэнэ.
EID_RP_UUID=
EID_RP_SECRET=
EID_RP_NAME=eID Gerege
EID_DISPLAY_TEXT=eID Gerege-д нэвтрэх
EID_BASE_URL=https://eidmongolia.mn/v3
EID_CERT_LEVEL=ADVANCED
EID_MOCK_MODE=false
EID_APP_CALLBACKS=gerege-eid://auth

# ------------------------------------------------------------------ нэвтрэлт
# Танигдсан хэрнээ бүртгэлгүй хүнд данс үүсэх үү.
#
# public: eID-ээр танигдсан иргэн бүртгэлтэй болж, ӨӨРИЙН гэртээ буудаг.
# private: зөвхөн урьдчилан бүртгэгдсэн хүн. Консол энэ утгыг дийлнэ.
PLATFORM_ACCESS_MODE=public

# ------------------------------------------------------- операторын консол
# Хоосон бол энэ суулгацад консол огт байхгүй (API нь /api/platform/v1 бүрд,
# бүрхүүл нь /cp дээр 404 хариулна). Нэршил: admin.<домэйн>.
CONTROL_PLANE_HOST=admin.eid.gerege.mn

# ------------------------------------------------------------------ бусад
# Gerege Core бүртгэлийн токен. Байхгүй бол шидтэн болон байгууллагын дэлгэц
# регистрээр хайхын оронд гараар бөглөнө.
GEREGE_CORE_TOKEN=

# ---------------------------------------------------------------- ажиглалт
#
# Ажиглалтын стек нь ТУСДАА compose төсөл (deploy/docker-compose.monitoring.yml)
# — платформ түүнээс хамаарахгүй тул доорх мөрүүд хоосон байхад `deploy.sh`
# хэвийн ажиллана. Зөвхөн ажиглалтын стекийг асаах үед л шаардагдана:
#
#   docker compose -f deploy/docker-compose.monitoring.yml --env-file ../.env up -d
#
# Дохио бүр дээр гарах нэр. 03:00 цагт сэрсэн хүн юуг ч нээхээсээ өмнө аль
# байрлуулалт болохыг эндээс уншина.
DEPLOYMENT_NAME=eid

# Платформын compose төслийн сүлжээ. `name: eid-nexus` + `_default`; өөр бол
# `docker network ls` аль нь болохыг хэлнэ.
NEXUS_NETWORK=eid-nexus_default

# Заавал (`:?`). admin/admin дээр сууж буй Grafana бол өөр хүний дэд бүтцийн
# нээлттэй самбар.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Заавал (`:?`). postgres_exporter нь `monitoring` role-оор холбогдоно —
# superuser-ээр биш. Цөмийн 00044 миграц тэр role-ыг НУУЦ ҮГГҮЙ үүсгэдэг
# (миграц бол репод хадгалагддаг файл) тул нэг удаа өөрөө өгнө:
#
#   docker exec -i gerege_eid_nexus_postgres psql -U postgres -d platform_db \
#     -c "ALTER ROLE monitoring WITH PASSWORD '<generated>'"
MONITORING_DB_PASSWORD=

# Grafana өөрийгөө хаана байгаа гэж бодох вэ. `/grafana` дэд зам нь код дотор
# бичээстэй — домэйны үндэс дээр landing хуудас сууна.
MONITORING_PUBLIC_URL=https://monitor.eid.gerege.mn

# Загвар: light эсвэл dark.
GRAFANA_DEFAULT_THEME=light

# Хэл. `sv-SE` нь Монгол хэлний ҮҮР: Grafana-д `mn` locale байхгүй тул
# deploy/scripts/setup_monitor_branding.sh швед хэлний chunk-ийг монгол
# орчуулгаар nginx дээр орлуулдаг. Скриптийг ажиллуулаагүй хостод үүнийг
# битгий sv-SE болго — швед хэл гарч ирнэ.
GRAFANA_DEFAULT_LANGUAGE=en-US

# Платформын бүртгэлээр нэвтрэх. Клиент бүртгээгүй байхад асаавал нэвтрэх
# дэлгэц дээр алдаа руу хөтөлдөг товч гарч ирнэ.
#
# Клиентийг консол дээр үүсгэж, redirect-ийг нь яг
# ${MONITORING_PUBLIC_URL}/grafana/login/generic_oauth гэж бүртгүүлнэ.
GRAFANA_OAUTH_ENABLED=false
GRAFANA_OAUTH_NAME=eID Gerege
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------- дохио
#
# Аль ч суваг бүрэн бөглөгдөөгүй бол ТЭР суваг унтраалттай — дохио асаж,
# Alertmanager болон Grafana дээр харагдаж, хаашаа ч илгээгдэхгүй. Хагас
# бөглөсөн суваг нь ажиллахгүй суваг биш, асахаас татгалзсан контейнер байх
# байсан; render-config.sh яг үүнээс сэргийлдэг.
ALERT_TIMEZONE=Asia/Ulaanbaatar
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --------------------------------------------------- trace ба алдааны хөтлөлт
#
# Хоёулаа хоосон бол ҮНЭХЭЭР унтраалттай: exporter байхгүй, дэвсгэр goroutine
# байхгүй. Ажиглалтын стек асаагүй байхад заавал хоосон байлга — байхгүй
# цэг рүү span илгээх нь хүсэлт бүрд нэг унасан холболт нэмнэ.
#
# Tempo нь платформын сүлжээн дээр тул контейнерийн нэрээр дуудагдана.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Жишээ (ажиглалтын стек асаалттай үед):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://gerege_eid_nexus_tempo:4318
OTEL_TRACES_SAMPLER_ARG=0.1

# GlitchTip-ийн DSN. Төслийг үүсгэсний дараа errors.eid.gerege.mn дээрээс
# хуулна. Backend ба бүрхүүл нь ХОЁР ӨӨР төсөл байх нь зөв: сервер талын
# panic ба браузарын алдаа хоёр өөр хүн уншдаг.
SENTRY_DSN=
FRONTEND_SENTRY_DSN=
# Аль хувилбарын алдаа болохыг үйл явдал дээр бичнэ.
RELEASE_VERSION=latest

# --------------------------------------------------------------- GlitchTip
#
# Тусдаа compose төсөл (deploy/docker-compose.glitchtip.yml), өөрийн Postgres,
# өөрийн Redis. Хоёулаа заавал (`:?`).
#
#   GLITCHTIP_SECRET_KEY: openssl rand -hex 32
#
# Эхний хэрэглэгч (нээлттэй бүртгэл байхгүй):
#   docker exec -it gerege_eid_nexus_glitchtip_web ./manage.py createsuperuser
GLITCHTIP_DOMAIN=https://errors.eid.gerege.mn
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
# consolemail:// нь урилгыг лог руу бичнэ. Жинхэнэ SMTP URL тавибал илгээгдэнэ.
GLITCHTIP_EMAIL_URL=consolemail://

# ---------------------------------------------------------------- нөөцлөлт
#
# deploy/scripts/backup.sh нь cron-оос ажиллана — compose-ийн үйлчилгээ биш.
# Доорх утгууд нь тэр скриптийн орчин; backups.eid.gerege.mn нь зөвхөн журмыг
# тайлбарлах статик хуудас.
#
#   15 3 * * * /opt/eid-nexus/src/deploy/scripts/backup.sh >> /var/log/eid-backup.log 2>&1
#
# Өөр байршил руу илгээх нь эдгээр бүгд бөглөгдсөн үед л ажиллана. AGE_RECIPIENT
# нь НИЙТИЙН түлхүүр: хостод хувийн түлхүүр байх ёсгүй, эс бөгөөс эвдэрсэн
# платформ өөрийн илгээсэн нөөцөө уншиж чадна.
#
# Зорилт нь цөмийн ажиллуулдаг обьект сан — ӨӨР МАШИН дээр
# (backups.nexus.gerege.mn). Энэ хост дээр өөрийн MinIO босгох нь нэг машин
# дээрх хоёр дахь хуулбар л болно: хүснэгт устгах, буруу миграц, volume
# дахин үүсэхээс хамгаална, ХОСТОО алдахаас биш. Тиймээс энд MinIO байхгүй —
# байгаа нэгэн рүү нь илгээнэ.
#
# Түлхүүр нь энэ байрлуулалтынх бөгөөд НЭМЖ чадна, УСТГАЖ чадахгүй: эзэмшигдсэн
# хост нь түүхийг арилгаж чадахгүй байх нь ransomware-ийг даван гардаг шинж.
BACKUP_KEEP_DAYS=14
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=https://backups.nexus.gerege.mn
BACKUP_S3_BUCKET=eid-nexus
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# --------------------------------------------------- төхөөрөмжийн шугамууд
#
# Native клиентүүдийн гарал. Шугам бүр өөрийн host дээр сууж, тэр host нь
# /api/v1-ийг ЭНЭ backend руу дамжуулдаг тул webview доторх дуудлага
# same-origin хэвээр — session cookie нь SameSite=Strict, CORS preflight
# үүсэхгүй (nginx/device-lines.eid.gerege.mn.conf).
#
# ДАРААЛАЛ: DNS → nginx → certbot → ХАМГИЙН СҮҮЛД клиентийн доторх хаяг.
# Эсрэгээр явбал апп байхгүй host руу чиглэж унана.
#
# Эдгээр хаягийг OAUTH_REDIRECT_HOSTS-д ч нэмэхээ бүү мартаарай: тэнд байхгүй
# host руу буцах redirect бүр татгалзагдана.
DEVICE_LINE_ORIGINS=https://desktop.eid.gerege.mn,https://mobile.eid.gerege.mn

# ---------------------------------------------------------- брэндийн бичвэр
#
# Хажуугийн цэсний «Гарын авлага». Хоосон бол цөмийн ном.
BRAND_DOCS_URL=

# Нэр, лого биш, БИЧВЭР дарж бичих цэг — brand/README.md үзнэ үү. Ихэнх
# суулгацад хоосон байх нь хэвийн; ЭНЭ суулгац дээр хоосон биш.
BRAND_COPY_FILE=/brand/copy.json

# ----------------------------------------------------------------- нүүр хуудас
#
# Хэсгүүд ба тэдгээрийн ДАРААЛАЛ. Энд бичсэн дараалал нь зурагдах дараалал,
# цэсний дараалал хоёулаа. Танихгүй нэр нь анхааруулгатайгаар хаягдана —
# бүхэлдээ таарахгүй бол бүтэн хуудас руу буцна.
#
# Боломжит нэрс: hero architecture services applications platform trust
#                capabilities technology
#
# `applications` энд байхгүй нь санаатай: энэ репо өөрийн модульгүй тул тэр
# хэсэг цөмийн ганц бүртгэлийн аппыг жагсаах байв.
LANDING_SECTIONS=hero capabilities trust services architecture platform technology

# «Энэ суулгац» хэсгийн картууд. Хаяггүй үйлчилгээ ЗУРАГДАХГҮЙ — хараахан
# босгоогүй зүйлээ зарлахаас сэргийлнэ. http(s) биш утга нь анхааруулгатайгаар
# хаягдана.
# Эдгээрийн анхдагч нь compose дотор ЭНЭ суулгацын хаягуудаар бичигдсэн —
# энд юу ч бичихгүй байсан ч зурагдана. `admin` нь хаягийн allowlist-ийн
# цаана тул анхдагчаараа хоосон: нээхээр шийдвэл л энд бич.
SERVICE_URL_EID=https://eidmongolia.mn
SERVICE_URL_ADMIN=
SERVICE_URL_DWH=https://dwh.eid.gerege.mn
SERVICE_URL_BACKUPS=https://backups.eid.gerege.mn
SERVICE_URL_MONITOR=https://monitor.eid.gerege.mn
# Хоосон: энэ суулгац хараахан өөрийн номгүй (BRAND_DOCS_URL-ыг ч үзнэ үү).
SERVICE_URL_DOCS=
